{
  "manifest_version": 3,
  "name": "Tabby",
  "version": "2.6.1",
  "description": "Friendly tab organization, focus-hour domain limits, sessions, deduplication, and window consolidation.",
  "icons": {
    "16": "icons/tabby-16.png",
    "32": "icons/tabby-32.png",
    "48": "icons/tabby-48.png",
    "128": "icons/tabby-128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "downloads"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabby",
    "default_icon": {
      "16": "icons/tabby-16.png",
      "32": "icons/tabby-32.png"
    }
  },
  "options_page": "dashboard.html",
  "commands": {
    "organize-tabs": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" },
      "description": "Merge, deduplicate, organize, and collapse inactive tabs"
    },
    "save-session": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current session"
    },
    "next-tab": {
      "suggested_key": { "default": "Alt+Shift+Right", "mac": "MacCtrl+Shift+Right" },
      "description": "Next tab, including tabs in collapsed groups"
    },
    "previous-tab": {
      "suggested_key": { "default": "Alt+Shift+Left", "mac": "MacCtrl+Shift+Left" },
      "description": "Previous tab, including tabs in collapsed groups"
    }
  }
}
